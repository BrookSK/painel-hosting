RewriteEngine On
Options -Indexes

 # Uploads nunca executam código (PHP/scripts) nem servem HTML/SVG
 #  (SVG só é permitido nas imagens enviadas pela equipe, nunca em anexos de clientes)
 RewriteRule ^uploads/.*\.(php\d?|phtml|phar|pl|py|cgi|sh|html?|js)$ - [R=404,L,NC]
 RewriteRule ^uploads/(?!imagens/).*\.svg$ - [R=404,L,NC]

 # Anexos do chat antigos: passam pelo painel (controle de acesso)
 RewriteRule ^uploads/chat/ index.php [L,NC]

 # Se o arquivo ou diretório físico existir, entrega direto
 RewriteCond %{REQUEST_FILENAME} -f [OR]
 RewriteCond %{REQUEST_FILENAME} -d
 RewriteRule ^ - [L]
 
 # Permitir acesso direto a arquivos JS, CSS, imagens
 RewriteCond %{REQUEST_URI} \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ [NC]
 RewriteRule ^ - [L]
 
 # Caso contrário, encaminha tudo para o front controller
 RewriteRule ^ index.php [L]
